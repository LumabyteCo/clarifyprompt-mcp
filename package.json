{
  "name": "clarifyprompt-mcp",
  "version": "1.3.0",
  "mcpName": "io.github.LumabyteCo/clarifyprompt",
  "description": "Context-aware MCP prompt compiler: persistent memory, knowledge packs, explicit token-budget curation, reflective learning, 58+ AI platforms, workspace signals (CLAUDE.md / AGENTS.md / .cursorrules), reasoning-model support. Stop tuning prompts — curate context.",
